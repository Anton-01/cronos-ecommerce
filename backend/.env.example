APP_NAME=Cronos
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
STOREFRONT_URL=http://localhost:3000
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cronos_dev
DB_USERNAME=cronos_owner
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
BROADCAST_CONNECTION=log
MAIL_MAILER=log
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_KEY=

# Media Library (local disk by default; set MEDIA_DISK_DRIVER=s3 + AWS_* for S3/MinIO)
MEDIA_DISK_DRIVER=local
MEDIA_MAX_UPLOAD_KB=10240

# Daily exchange-rate refresh (pricing:update-rates)
EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/{base}
EXCHANGE_RATES_MAX_CHANGE=25
TRUSTED_PROXIES=
GEO_DEFAULT_TIMEZONE=America/Mexico_City
# GEO_COUNTRY_HEADER=CF-IPCountry
MEDIA_ANTIVIRUS=null
