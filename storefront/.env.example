# Base URL of the Laravel API (server side only; the browser talks to /api/graphql on this same site).
API_URL=http://localhost:8000
# Same secret as STOREFRONT_REVALIDATE_SECRET in the API: lets it tell this site "that page changed" so cached content refreshes at once.
REVALIDATE_SECRET=
# Public address of the storefront (canonicals, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
