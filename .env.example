# Compose-level variables (copy to .env). App variables live in backend/.env
COMPOSE_PROJECT_NAME=cronos
APP_ENV=local

POSTGRES_DB=cronos
POSTGRES_USER=cronos_owner
POSTGRES_PASSWORD=change-me-owner
# Least-privilege runtime role (no UPDATE/DELETE on immutable tables)
POSTGRES_APP_USER=cronos_app
POSTGRES_APP_PASSWORD=change-me-app

REDIS_PASSWORD=change-me-redis

MINIO_ROOT_USER=cronos
MINIO_ROOT_PASSWORD=change-me-minio
